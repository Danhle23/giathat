# Public site URL (used for canonical links, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your Shopee affiliate id — embedded into outgoing affiliate links.
SHOPEE_AFFILIATE_ID=giathat

# --- Telegram deal bot (auto-posts genuine deals to your channel) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel id or @username (bot must be an admin of the channel)
TELEGRAM_CHAT_ID=@your_channel
# Protects the cron endpoint; Vercel Cron sends it as a Bearer token
CRON_SECRET=

# --- For the production (real data) version, not needed for the MVP ---
# Postgres connection string (see prisma/schema.prisma)
# DATABASE_URL=postgresql://user:password@localhost:5432/giathat

# Shopee Affiliate Open Platform credentials (apply for access first)
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
