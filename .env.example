# Public site URL (used for canonical links, sitemap, OG). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Your Shopee affiliate id — embedded into outgoing affiliate links.
SHOPEE_AFFILIATE_ID=giathat

# --- AccessTrade (auto product feed + ready affiliate links) ---
# API key: pub.accesstrade.vn → Profile → API Key (KEEP SECRET)
ACCESSTRADE_API_KEY=
# Campaign/merchant slug for the datafeed, e.g. shopee (must be an APPROVED campaign)
ACCESSTRADE_CAMPAIGN=shopee

# --- Telegram deal bot (auto-posts genuine deals to your channel) ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Channel id or @username (bot must be an admin of the channel)
TELEGRAM_CHAT_ID=@your_channel
# Protects the cron endpoint; Vercel Cron sends it as a Bearer token
CRON_SECRET=

# Postgres (Neon/Supabase) — stores synced products + daily price snapshots
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Shopee Affiliate Open Platform credentials (apply for access first)
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
