// Production data model for Giá Thật (Postgres).
//
// The MVP runs on an in-memory repository seeded with mock data
// (see src/lib/repository.ts + src/lib/seed.ts). This schema is the target
// for going live: run `npm i -D prisma @prisma/client`, `npx prisma migrate dev`,
// then implement a Prisma-backed repository that satisfies the same functions.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id          String          @id // url slug
  itemId      BigInt          @unique
  shopId      BigInt
  name        String
  category    String
  shop        String
  url         String
  listedPrice Int
  currentPrice Int
  rating      Float
  sold        Int
  createdAt   DateTime        @default(now())
  snapshots   PriceSnapshot[]
  alerts      Alert[]

  @@index([category])
}

model PriceSnapshot {
  id        Int      @id @default(autoincrement())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price     Int
  capturedAt DateTime @default(now())

  @@index([productId, capturedAt])
}

model Alert {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  email       String
  targetPrice Int      @default(0) // 0 = notify on any genuine drop
  notifiedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([productId])
  @@index([email])
}
